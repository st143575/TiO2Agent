TIO2_HOST=0.0.0.0
TIO2_PORT=8000
TIO2_LOG_LEVEL=INFO

# PDFs, intermediate results and the SQLite database are stored in data/
TIO2_DATA_DIR=data

# Upload limits
TIO2_MAX_UPLOAD_MB=50
TIO2_MAX_PAGES=200

# Number of documents processed in parallel in the background
TIO2_INGEST_WORKERS=2

# --- OCR for image tables and scanned pages ----------------------------------------
# none: no OCR (no GPU needed); image regions are listed as warnings on the document.
# paddleocr_vl: send them to a PaddleOCR-VL pipeline service (POST /layout-parsing).
TIO2_OCR_BACKEND=none
# Local runs only; inside Docker Compose the app always uses http://paddleocr-vl-api:8080
TIO2_OCR_BASE_URL=http://localhost:8080
TIO2_OCR_TIMEOUT_S=300

# --- Chunking and search -------------------------------------------------------------
TIO2_CHUNK_MAX_CHARS=600
TIO2_SEARCH_TOP_K=8

# --- Embeddings (optional) --------------------------------------------------------------
# none: keyword (BM25) search only. 
# openai_compatible: any /v1/embeddings endpoint, e.g.
#   Ollama:  ollama pull bge-m3  ->  TIO2_EMBEDDING_BASE_URL=http://localhost:11434/v1
#   a hosted API: set its base URL, model name and TIO2_EMBEDDING_API_KEY
# Changing the model requires re-indexing (POST /api/v1/documents/{id}/reindex).
TIO2_EMBEDDING_BACKEND=none
TIO2_EMBEDDING_BASE_URL=http://localhost:11434/v1
# Used instead of the line above inside Docker Compose
DOCKER_EMBEDDING_BASE_URL=http://host.docker.internal:11434/v1
TIO2_EMBEDDING_MODEL=bge-m3
# TIO2_EMBEDDING_API_KEY=

# --- Reranking (optional) ---------------------------------------------------------------
# A cross-encoder re-scores the top TIO2_RERANK_CANDIDATES fused hits. Requests go to {TIO2_RERANK_BASE_URL}/rerank.
# cohere_compatible: vLLM, SGLang, Jina, Cohere, hosted APIs  -> base URL ends in /v1
#   vllm serve BAAI/bge-reranker-v2-m3 --port 8001  (8000 is this app)
# tei: Hugging Face text-embeddings-inference                 -> base URL without /v1
TIO2_RERANK_BACKEND=none
TIO2_RERANK_BASE_URL=http://localhost:8001/v1
TIO2_RERANK_MODEL=BAAI/bge-reranker-v2-m3
# TIO2_RERANK_API_KEY=
TIO2_RERANK_CANDIDATES=30
# Used instead of TIO2_RERANK_BASE_URL inside Docker Compose
DOCKER_RERANK_BASE_URL=http://host.docker.internal:8001/v1

# --- LLM for the Agent (POST /api/v1/agent/chat) --------------------------------------
# none: /agent/chat answers 503. 
# openai_compatible: any /v1/chat/completions endpoint with tool calling, e.g.
#   Ollama:  ollama pull qwen3:8b  ->  TIO2_LLM_BASE_URL=http://localhost:11434/v1
#   vLLM:    vllm serve Qwen/Qwen3-8B --enable-auto-tool-choice --tool-call-parser hermes --port 8002
#   a hosted API: set its base URL, model name and TIO2_LLM_API_KEY
TIO2_LLM_BACKEND=openai_compatible
TIO2_LLM_BASE_URL=http://localhost:11434/v1
# Used instead of the line above inside Docker Compose
DOCKER_LLM_BASE_URL=http://host.docker.internal:11434/v1
TIO2_LLM_MODEL=qwen3:8b
# TIO2_LLM_API_KEY=
TIO2_LLM_TEMPERATURE=0
TIO2_LLM_TIMEOUT_S=120
# --- Fact extraction (patents) ----------------------------------------------------------
# rules:  rule-based extractor only (default, no LLM needed)
# llm:    the LLM above reads each claim and each example; every fact it proposes must
#         quote the text and contain its numbers, or it is dropped
# hybrid: both; where they find the same number the LLM's name is used
# llm / hybrid make about one LLM call per claim and per example (10-15 per patent).
# Re-extract existing documents with POST /api/v1/documents/{id}/reindex.
TIO2_EXTRACT_BACKEND=hybrid
# TIO2_EXTRACT_LLM_MODEL=          # default: TIO2_LLM_MODEL
# "none" turns thinking off (Ollama: qwen3 etc.); extraction does not need it, and with
# thinking on qwen3 may repeat itself until max_tokens and time out. Leave empty for
# APIs that reject the "reasoning_effort" field.
TIO2_EXTRACT_LLM_REASONING_EFFORT=none
TIO2_EXTRACT_LLM_TEMPERATURE=0
TIO2_EXTRACT_LLM_MAX_TOKENS=4096
TIO2_EXTRACT_LLM_TIMEOUT_S=300
# after this many failed requests in a row, stop calling the LLM for that document
TIO2_EXTRACT_LLM_MAX_FAILURES=2

# LLM calls per question, and earlier Q&A pairs sent as context
TIO2_AGENT_MAX_STEPS=8
TIO2_AGENT_HISTORY_TURNS=4

# --- Docker Compose ----------------------------------------------------------------
# Run the LLM inside Compose (Ollama) with a plain "docker compose up -d": uncomment.
# On an NVIDIA host use compose.yaml:compose.ollama.yaml:compose.ollama-gpu.yaml.
# Not on a Mac: there, run Ollama natively (Docker cannot use the Apple GPU).
# COMPOSE_FILE=compose.yaml:compose.ollama.yaml
# OLLAMA_IMAGE_TAG=latest
# OLLAMA_CONTEXT_LENGTH=16384
# OLLAMA_PORT=11435
# OLLAMA_GPU_ID=0
#
# To run PaddleOCR-VL with Compose (NVIDIA GPU), uncomment both lines below and set
# TIO2_OCR_BACKEND=paddleocr_vl above.
# COMPOSE_PROFILES=ocr
# PADDLEOCR_GPU_ID=0
# Pin a release for reproducibility, e.g. paddleocr3.3-nvidia-gpu-offline
PADDLEOCR_IMAGE_TAG=latest-nvidia-gpu-offline
PADDLEOCR_VLM_BACKEND=vllm
PADDLEOCR_SHM_SIZE=64g
